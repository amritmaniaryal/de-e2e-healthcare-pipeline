FROM apache/airflow:3.3.2

# Spark needs a JVM on whatever machine runs spark-submit. apt needs root, so
# step out of the airflow user, install, then step back in.
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends default-jre-headless curl procps \
    && rm -rf /var/lib/apt/lists/*

USER airflow
RUN pip install --no-cache-dir \
    apache-airflow-providers-amazon==9.35.0 \
    boto3 \
    pyspark==3.5.3 \
 && SPARK_JARS="$(python -c 'import os,pyspark;print(os.path.join(os.path.dirname(pyspark.__file__),"jars"))')" \
 && curl -fsSL -o "$SPARK_JARS/hadoop-aws-3.3.4.jar" \
      https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar \
 && curl -fsSL -o "$SPARK_JARS/aws-java-sdk-bundle-1.12.262.jar" \
      https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar