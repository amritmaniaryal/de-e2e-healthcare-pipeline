# Docker Compose settings for the Airflow stack.
#
# This file is a TEMPLATE. Copy it to `docker/.env` and fill in real values:
#     cp docker/.env.example docker/.env
#
# Compose reads this file automatically when run from the `docker/` directory.

# Path to the repo root, from `docker/`. Keep as-is.
AIRFLOW_PROJ_DIR=..

# Host user id, so files written into mounted volumes are owned by you.
# On macOS/Linux: id -u
AIRFLOW_UID=50000

# Path to the credentials file, relative to `docker/`.
ENV_FILE_PATH=../.env

# Airflow Fernet key — encrypts connection passwords in the metadata DB.
# Generate your own, do not reuse anyone else's:
#     python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-me

AIRFLOW_IMAGE_NAME=healthcare-airflow:3.3.2
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
