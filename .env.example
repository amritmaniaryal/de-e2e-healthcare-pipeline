# Environment for the pipeline's host-side tooling: the Spark jobs, dbt, and
# anything run from this checkout.
#
# This file is a TEMPLATE. Copy it to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored — never commit real credentials.

# --- AWS -------------------------------------------------------------------
#
# Credentials for the extract and Spark stages.
#
# Scope the IAM user to the project bucket only. The pipeline needs:
#     s3:GetObject  s3:PutObject  s3:DeleteObject  s3:ListBucket
# `s3:DeleteObject` is required: Spark commits Parquet by staging into
# `_temporary/` and renaming, and on S3 a rename is a copy followed by a delete.

AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_DEFAULT_REGION=us-east-2

# Bucket that holds the raw/ and processed/ zones.
S3_BUCKET=replace-me

# --- Snowflake -------------------------------------------------------------
#
# Read by `dbt/profiles.yml` through `env_var()`. The same five values are
# stored as GitHub Actions secrets for the CI workflow — this file is what tells
# you which ones CI needs.
#
# Authentication is a key pair, not a password. Snowflake now requires MFA for
# password logins, which an unattended CI runner cannot satisfy. Register the
# public half once:
#     ALTER USER <user> SET RSA_PUBLIC_KEY='<base64 body of rsa_key.pub>';
# and keep the private half outside the repo, mode 0600 (e.g. ~/.snowflake).

SNOWFLAKE_ACCOUNT=replace-me
SNOWFLAKE_USER=replace-me
SNOWFLAKE_ROLE=replace-me
SNOWFLAKE_WAREHOUSE=replace-me

# Absolute path — dbt hands this string to Python, which does not expand ~ or
# $HOME. A tilde here fails as "file not found".
SNOWFLAKE_PRIVATE_KEY_PATH=replace-me
